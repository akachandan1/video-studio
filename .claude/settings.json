{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/setup/doctor.sh\" --quiet",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash setup/doctor.sh:*)",
      "Bash(setup/doctor.sh:*)",
      "Bash(npx --yes hyperframes@0.8.172 lint:*)",
      "Bash(npx --yes hyperframes@0.8.172 check:*)",
      "Bash(npx --yes hyperframes@0.8.172 snapshot:*)",
      "Bash(npx --yes hyperframes@0.8.172 render:*)",
      "Bash(ffprobe:*)"
    ]
  }
}
